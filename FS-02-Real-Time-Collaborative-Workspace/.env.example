# PostgreSQL - Direct connection for Prisma CLI/migrations
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# PostgreSQL - Pooled connection for application runtime
DATABASE_URL_POOLED="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Authentication
JWT_SECRET="replace_with_a_long_random_secret"

# Frontend WebSocket URL
NEXT_PUBLIC_REALTIME_URL="ws://localhost:4000"

# Internal communication secret
REALTIME_INTERNAL_SECRET="replace_with_another_long_random_secret"

# Redis / Upstash
REDIS_URL="rediss://default:YOUR_PASSWORD@YOUR_REDIS_HOST:6379"

# Realtime server
REALTIME_PORT=4000